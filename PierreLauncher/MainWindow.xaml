<Window x:Class="PierreLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pierre Client Launcher" 
        Height="540" Width="890"
        Icon="Assets/icon.png"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Header Window Buttons Style -->
        <Style x:Key="HeaderBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0AAB0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Sleek Dark CheckBox Style with Emerald Green Checkmark -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="chkBorder" Width="20" Height="20" CornerRadius="5" Background="#141820" BorderBrush="#35FFFFFF" BorderThickness="1.5" Margin="0,0,10,0">
                                    <TextBlock x:Name="chkMark" Text="✓" Foreground="#000000" FontSize="13" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBorder" Property="Background" Value="#00E676"/>
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#00E676"/>
                                <Setter TargetName="chkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#00E676"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Buttons with Scale Animation -->
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#20000000"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40000000"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00E676"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Accent Rounded Button -->
        <Style x:Key="GreenBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#00E676"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#69F0AE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Solid Button -->
        <Style x:Key="DarkCardBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2430"/>
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#353D4D" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3242"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00E676"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Sleek Scrollbar Style (Ultra Thin & Clean) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#4000E676"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark Custom ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#181D26"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateBorder" CornerRadius="8" Background="#181D26" BorderBrush="#30FFFFFF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="8,6" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#00E676" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="templateBorder" Property="BorderBrush" Value="#00E676"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,6,30,6" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#141820" BorderBrush="#00E676" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2500E676"/>
                                <Setter Property="Foreground" Value="#00E676"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3500E676"/>
                                <Setter Property="Foreground" Value="#00E676"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Big Play Button Style with Glow & Scale Animation -->
        <Style x:Key="BigPlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00E676"/>
            <Setter Property="Foreground" Value="#10141D"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PlayBorder" Background="{TemplateBinding Background}" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="PlayGlow" Color="#00E676" BlurRadius="5" Opacity="0.3" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PlayBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="PlayBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="PlayGlow" Storyboard.TargetProperty="BlurRadius" To="25" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="PlayGlow" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PlayBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="PlayBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="PlayGlow" Storyboard.TargetProperty="BlurRadius" To="5" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="PlayGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Main Container with 100% PERFECT OVAL ROUNDED CORNERS (CornerRadius="26") -->
    <Border CornerRadius="26" BorderBrush="Transparent" BorderThickness="0" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" Color="#000000" Opacity="0.95" ShadowDepth="4"/>
        </Border.Effect>
        <Border.Background>
            <ImageBrush ImageSource="Assets/background.jpg" Stretch="UniformToFill"/>
        </Border.Background>

        <Grid>
            <!-- SEMI-TRANSPARENT DARK GREEN & SLATE GLASS OVERLAY LAYER -->
            <Border CornerRadius="24" Background="#D80C1017"/>

            <!-- MAIN CONTAINER GRID -->
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Main Body Area -->
                    <RowDefinition Height="Auto"/> <!-- Footer / Version -->
                </Grid.RowDefinitions>

                <!-- TOP HEADER BAR -->
                <Grid Grid.Row="0" Margin="4,0,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Logo & Subtext (PROPORTIONATE PROMINENT GREEN CAPSULE LOGO) -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Image x:Name="ImgHeaderLogo" Source="Assets/logo_p.png" Height="30" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,4" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TxtWelcomeSubtitle" Text="Oynayın ve daha iyi bir deneyimin tadını çıkarın!" Foreground="#B0BEC5" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Drag Handle Area -->
                    <Grid Grid.Column="1" Background="Transparent"/>

                    <!-- Custom Window Controls (ONLY Minimize and Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource HeaderBtnStyle}" Content="─" Click="MinimizeBtn_Click"/>
                        <Button Style="{StaticResource HeaderBtnStyle}" Content="✕" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- MAIN BODY AREA (HERO & LAUNCH OR ACCOUNT VIEW) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT / MAIN VIEW (DASHBOARD & LAUNCH OR ACCOUNTS) -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- DASHBOARD HERO CARD -->
                        <Border Grid.Row="0" CornerRadius="18" BorderBrush="#25FFFFFF" BorderThickness="1" Background="#60080B10" ClipToBounds="True" Padding="16">
                            <Grid>
                                <!-- SCREEN 1 / 3: ACCOUNT SELECTION & MANAGE OVERLAY -->
                                <Grid x:Name="AccountSelectionOverlay" Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Header Title with Green Underline -->
                                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <TextBlock x:Name="TxtAccountSelectHeader" Text="Bir hesap seçin" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <Rectangle Width="90" Height="3" Fill="#00E676" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- NO ACCOUNTS CARD (Screen 1) -->
                                        <Border x:Name="CardNoAccounts" CornerRadius="12" Background="#800D111A" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="24" Width="360" Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Henüz oluşturulmuş hesap yok" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Aşağıdaki düğmeye tıklayarak yeni bir tane oluşturun ;)" Foreground="#A0AAB0" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ACCOUNTS LIST CARDS (Screen 3) -->
                                        <ScrollViewer x:Name="ScrollAccountsList" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                                            <StackPanel x:Name="AccountsContainer" Width="380"/>
                                        </ScrollViewer>

                                        <!-- ADD ACCOUNT BUTTON -->
                                        <Button Style="{StaticResource DarkCardBtnStyle}" Width="160" Height="40" Click="OpenAddAccountModal_Click" Margin="0,12,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👤" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtAddAccountBtn" Text="Hesap Ekle" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- DASHBOARD LAUNCH VIEW (MAIN HERO SCREEN) -->
                                <Grid x:Name="MainLaunchView" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Account Header Bar -->
                                        <RowDefinition Height="*"/>    <!-- Character / Logo Graphic -->
                                        <RowDefinition Height="Auto"/> <!-- Launch Button & Status -->
                                    </Grid.RowDefinitions>

                                    <!-- Top Account Header -->
                                    <Grid Grid.Row="0">
                                        <Border Background="#900D111A" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,6" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👤" Foreground="#00E676" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtActiveUser" Text="Kullanıcı Seçilmedi" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource IconBtnStyle}" Width="36" Height="34" Margin="0,0,6,0" ToolTip="Launcher Ayarları" Click="ToggleSettingsDrawer_Click">
                                                <TextBlock Text="⚙" FontSize="15"/>
                                            </Button>
                                            <Button Style="{StaticResource IconBtnStyle}" Width="36" Height="34" ToolTip="Hesap Seç / Değiştir" Click="ShowAccountSelection_Click">
                                                <TextBlock Text="🔄" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hero Logo Area (Cleanly Scaled Logo + Well-Spaced Text) -->
                                    <Grid Grid.Row="1" Margin="0,6">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image x:Name="ImgCenterLogo" Source="Assets/logo_p.png" Height="80" Stretch="Uniform" Margin="0,0,0,10" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="Fabric 1.21.11 | PierreClient &amp; Fabric API Ready" Foreground="#00E676" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Launch Section -->
                                    <StackPanel Grid.Row="2">
                                        <!-- Progress Bar -->
                                        <ProgressBar x:Name="LaunchProgressBar" Height="4" Background="#30FFFFFF" Foreground="#00E676" BorderThickness="0" Margin="0,0,0,8" Value="0" Visibility="Collapsed"/>

                                        <!-- Status Label -->
                                        <TextBlock x:Name="TxtStatus" Text="Oyuna başlanmaya hazır." Foreground="#A0AAB0" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                                        <!-- Glowing LAUNCH Button Row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- CM CLIENT STYLE LAUNCH BUTTON (Green Palette) -->
                                            <Button x:Name="BtnPlay" Grid.Column="0" Height="50" Cursor="Hand" Click="BtnPlay_Click" Style="{StaticResource BigPlayButtonStyle}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="▶" Foreground="#10141D" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="LAUNCH 1.21.11" Foreground="#10141D" FontWeight="Black" FontSize="17"/>
                                                        <TextBlock Text="PIERRE CLIENT FABRIC MODDED" Foreground="#10141D" FontSize="9" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>

                                            <!-- Version Option Button -->
                                            <Button Grid.Column="2" Style="{StaticResource IconBtnStyle}" Width="50" Height="50" ToolTip="Sürüm Detayları">
                                                <TextBlock Text="⇅" FontSize="20" Foreground="#FFFFFF"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- QUICK PLAY SERVERS CONTAINER (Empty placeholder) -->
                        <Border Grid.Row="1" CornerRadius="14" Background="#5007090D" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="12,10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtQuickPlayLabel" Grid.Column="0" Text="Quick Play:" Foreground="#00E676" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="TxtQuickPlayStatus" Grid.Column="1" Text="(Sunucu Eklenmedi)" Foreground="#60FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RIGHT SIDE NEWS DRAWER (Shown when settings are closed) -->
                    <Border x:Name="NewsPanel" Grid.Column="1" Width="335" CornerRadius="18" BorderBrush="#30FFFFFF" BorderThickness="1" Background="#F40D1118" Padding="16" Visibility="Visible">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NewsPanelTransform" X="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- News Header -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock x:Name="TxtNewsTitle" Text="Son Haberler" Foreground="#00E676" FontSize="16" FontWeight="Bold"/>
                                <Rectangle Width="70" Height="3" Fill="#00E676" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                            
                            <!-- News Content List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                                <StackPanel>
                                    <Border Background="#141820" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtNews1Title" Text="Pierre Client Yayında!" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtNews1Desc" Text="1.21.11 Fabric altyapısıyla yep yeni Pierre Client sürümü artık erişilebilir. Modlar entegre edildi, stabilite artırıldı." Foreground="#A0AAB0" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtNews1Date" Text="Bugün, 12:00" Foreground="#00E676" FontSize="9" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#141820" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtNews2Title" Text="Anti-Tamper Aktif" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtNews2Desc" Text="İzinsiz mod eklemeyi önleyen güvenlik sistemi aktifleştirildi. Client artık çok daha güvenli." Foreground="#A0AAB0" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtNews2Date" Text="Dün, 18:30" Foreground="#00E676" FontSize="9" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- RIGHT SIDE LAUNCHER SETTINGS DRAWER (With Smooth Slide Transform & Thin Scrollbar) -->
                    <Border x:Name="SettingsDrawer" Grid.Column="1" Width="335" CornerRadius="18" BorderBrush="#30FFFFFF" BorderThickness="1" Background="#F40D1118" Padding="16" Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SettingsDrawerTransform" X="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Static Locked Java 21 Badge (No Selector Dropdown) -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Border Background="#181D26" BorderBrush="#00E676" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="☕ " Foreground="#00E676" FontSize="13"/>
                                        <TextBlock x:Name="TxtJavaBadge" Text="Java 21 (Varsayılan - Sabit)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Fixed ScrollViewer with thin custom scrollbar -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                                <StackPanel>
                                    <!-- Settings Header with Green Underline -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock x:Name="TxtSettingsHeader" Text="Launcher settings" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                                        <Rectangle Width="70" Height="3" Fill="#00E676" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <!-- Language Dropdown -->
                                    <TextBlock x:Name="TxtLanguageLabel" Text="Language:" Foreground="#A0AAB0" FontSize="12" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,12">
                                        <ComboBox x:Name="CmbLanguage" SelectedIndex="0">
                                            <ComboBoxItem Content="Türkçe"/>
                                            <ComboBoxItem Content="English"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Branch Dropdown -->
                                    <TextBlock x:Name="TxtBranchLabel" Text="Branch:" Foreground="#A0AAB0" FontSize="12" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,14">
                                        <ComboBox x:Name="CmbBranch" SelectedIndex="0">
                                            <ComboBoxItem Content="master"/>
                                            <ComboBoxItem Content="release"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Memory / RAM Slider -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock x:Name="TxtMemoryLabel" Text="Memory:" Foreground="#A0AAB0" FontSize="12"/>
                                        <TextBlock x:Name="TxtRamDisplay" Text="4.0 GB" Foreground="#00E676" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SliderMemoryGb" Minimum="0.5" Maximum="16" SmallChange="0.5" LargeChange="1.0" Value="4.0" ValueChanged="SliderMemoryGb_ValueChanged" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="0.5 GB" Foreground="#60FFFFFF" FontSize="10" HorizontalAlignment="Left"/>
                                        <TextBlock Text="16 GB" Foreground="#60FFFFFF" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Game Directory Input -->
                                    <TextBlock x:Name="TxtGameDirLabel" Text="Game directory:" Foreground="#A0AAB0" FontSize="12" Margin="0,0,0,4"/>
                                    <Border Background="#141820" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtGameDirectory" Background="Transparent" Foreground="#D0D0D0" BorderThickness="0" FontSize="11" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="📁" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="BrowseGameDir_Click" Margin="4,0,2,0"/>
                                                <Button Content="🔄" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="ResetGameDir_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- JVM Arguments Input -->
                                    <TextBlock x:Name="TxtJvmArgsLabel" Text="JVM arguments:" Foreground="#A0AAB0" FontSize="12" Margin="0,0,0,4"/>
                                    <Border Background="#141820" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtJvmArgs" Background="Transparent" Foreground="#D0D0D0" BorderThickness="0" FontSize="11" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="🔄" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="ResetJvmArgs_Click" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Sleek Custom Styled Checkboxes -->
                                    <CheckBox x:Name="ChkMinimizeOnLaunch" Content="Minimize on game launch" IsChecked="True" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ChkCloseOnLaunch" Content="Close on game launch" IsChecked="False" Margin="0,0,0,14"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Bottom Action Buttons -->
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource GreenBtnStyle}" Height="38" Click="SaveSettings_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾 " FontSize="12"/>
                                        <TextBlock x:Name="BtnSaveText" Text="SAVE" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnGoBack" Grid.Column="2" Style="{StaticResource DarkCardBtnStyle}" Content="Go Back" Height="38" Click="CloseSettingsDrawer_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- FOOTER BAR (Updated Version String: Version: 0.0.1 (Alpha)) -->
                <Grid Grid.Row="2" Margin="4,6,4,0">
                    <TextBlock Text="Version: 0.0.1 (Alpha) • Pierre Client Fabric 1.21.11" Foreground="#70FFFFFF" FontSize="11" HorizontalAlignment="Left"/>
                </Grid>

                <!-- SNACKBAR NOTIFICATION (Appears from bottom) -->
                <Border x:Name="SnackbarPanel" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Padding="16,10" Background="#F400E676" CornerRadius="12" Visibility="Collapsed" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SnackbarTransform" Y="20"/>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="#10141D" FontWeight="Bold" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSnackbarMessage" Text="Ayarlar başarıyla kaydedildi!" Foreground="#10141D" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SIMPLIFIED HESAP EKLE MODAL (Only Offline Cracked Username Entry) -->
            <Grid x:Name="AddAccountModalOverlay" Background="#E505070A" Visibility="Collapsed">
                <Border Width="360" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="18" Background="#0F121B" BorderBrush="#00E676" BorderThickness="1.5" Padding="24">
                    <Grid>
                        <StackPanel>
                            <!-- Header Title with Green Underline -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock x:Name="TxtAddAccountTitle" Text="Hesap ekle" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Rectangle Width="70" Height="3" Fill="#00E676" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Username Input -->
                            <TextBlock x:Name="TxtAddAccountDesc" Text="👤 Kullanıcı Adı (Nickname):" Foreground="#A0AAB0" FontSize="12" Margin="0,0,0,6"/>
                            <Border Background="#1C212D" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,20">
                                <TextBox x:Name="TxtInputUsername" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="14" FontFamily="Consolas" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Single Clean Offline Add Button -->
                            <Button x:Name="BtnAddAccount" Style="{StaticResource GreenBtnStyle}" Height="42" Click="AddOfflineAccount_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⊘ " FontSize="14"/>
                                    <TextBlock x:Name="TxtBtnAddAccount" Text="ÇEVRİMDIŞI HESAP EKLE" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Close Button X -->
                        <Button x:Name="BtnCancelAddAccount" Style="{StaticResource HeaderBtnStyle}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseAddAccountModal_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- GAME LOADING OVERLAY (Shows while java.exe is booting) -->
            <Grid x:Name="GameLoadingOverlay" Background="#F005070A" Visibility="Collapsed" Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="96" Height="96" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Image.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.5" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                    <TextBlock Text="Oyun Hazırlanıyor..." Foreground="#FFFFFF" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Minecraft başlatılıyor. Modların yüklenmesi bilgisayarınıza bağlı olarak ortalama 30-60 saniye sürebilir." Foreground="#A0AAB0" FontSize="13" TextWrapping="Wrap" MaxWidth="350" TextAlignment="Center" Margin="0,0,0,12"/>
                    
                    <ProgressBar IsIndeterminate="True" Height="4" Width="200" Foreground="#00E676" Background="#20FFFFFF" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
