<Window x:Class="PierreLauncher.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pierre Launcher Loading" 
        Height="300" Width="450"
        Icon="Assets/logo_p.png"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Storyboards for Fade In/Out -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Background Overlay -->
        <Border CornerRadius="16" Background="#0C1017" BorderBrush="#1C2433" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5"/>
            </Border.Effect>
        </Border>

        <!-- Content -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="Assets/logo_p.png" Height="130" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,20"/>
            
            <TextBlock x:Name="TxtStatus" Text="Sistem Dosyaları Kontrol Ediliyor..." Foreground="#B0BEC5" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            <!-- Custom Progress Bar -->
            <Border Background="#151A22" CornerRadius="4" Height="8" Width="250" HorizontalAlignment="Center">
                <Border x:Name="ProgressBar" Background="#00E676" CornerRadius="4" Width="0" HorizontalAlignment="Left">
                    <!-- Glow Effect on progress -->
                    <Border.Effect>
                        <DropShadowEffect Color="#00E676" BlurRadius="10" Opacity="0.6" ShadowDepth="0"/>
                    </Border.Effect>
                </Border>
            </Border>
        </StackPanel>
    </Grid>
</Window>
